---
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  items: { q: { en: string; es: string }; a: { en: string; es: string } }[];
}
const { lang, items } = Astro.props;
---

<div class="faq">
  {
    items.map((it, i) => (
      <details class="faq__item" open={i === 0}>
        <summary>
          <span>{it.q[lang]}</span>
          <span class="faq__plus" aria-hidden="true" />
        </summary>
        <p>{it.a[lang]}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: 820px;
    margin-inline: auto;
    display: grid;
    gap: 12px;
  }
  .faq__item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 22px;
  }
  .faq__item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--green-900);
    cursor: pointer;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item p {
    color: var(--ink-soft);
    margin: 0;
    padding-bottom: 20px;
  }
  .faq__plus {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--green-100);
    flex: none;
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--green-700);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }
  .faq__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq__item[open] .faq__plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
</style>
