---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Service } from '../data/services';
import { servicePath, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  service: Service;
  lang: Lang;
}
const { service: s, lang } = Astro.props;
const t = useT(lang);
---

<a class="scard reveal" href={servicePath(s.slug, lang)}>
  <div class="scard__media">
    <Image quality={68} src={s.image} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 380px" />
  </div>
  <div class="scard__body">
    <span class="scard__icon"><Icon name={s.icon} size={24} /></span>
    <h3>{s.title[lang]}</h3>
    <p>{s.short[lang]}</p>
    <span class="scard__more">{t('cta.learnMore')} <Icon name="arrow" size={18} /></span>
  </div>
</a>

<style>
  .scard {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .scard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    color: inherit;
  }
  .scard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sand-200);
  }
  .scard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .scard:hover .scard__media :global(img) {
    transform: scale(1.05);
  }
  .scard__icon {
    position: absolute;
    left: 18px;
    top: -26px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--green-700);
    color: var(--white);
    box-shadow: var(--shadow);
    border: 3px solid var(--white);
  }
  .scard__body {
    position: relative;
    padding: 34px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .scard__body p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    flex: 1;
  }
  .scard__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--green-600);
  }
</style>
