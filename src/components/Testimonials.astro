---
import { reviews as allReviews, type Review } from '../data/reviews';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  limit?: number;
  full?: boolean;
  items?: Review[];
}
const { lang, limit, full = false, items } = Astro.props;
const t = useT(lang);
const list = (items ?? allReviews).slice(0, limit);
const initials = (name: string) => name.split(' ').map((p) => p[0]).join('').slice(0, 2);
---

<div class:list={['reviews', { 'reviews--full': full }]}>
  {
    site.googleRating && (
      <p class="reviews__rating">
        ★ {site.googleRating.rating.toFixed(1)} · {site.googleRating.count} {lang === 'en' ? 'Google reviews' : 'reseñas en Google'}
      </p>
    )
  }
  <div class="reviews__grid">
    {
      list.map((rv) => (
        <figure class="review reveal">
          <svg class="review__quote" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M13 7H7a4 4 0 0 0-4 4v6a4 4 0 0 0 4 4h3v4l5-4v-10a4 4 0 0 0-2-4zm16 0h-6a4 4 0 0 0-4 4v6a4 4 0 0 0 4 4h3v4l5-4v-10a4 4 0 0 0-2-4z" fill="currentColor" />
          </svg>
          <blockquote>
            <p class="review__highlight">“{rv.highlight[lang]}”</p>
            {full && <p class="review__text">{rv.text[lang]}</p>}
          </blockquote>
          <figcaption>
            <span class="review__avatar" aria-hidden="true">{initials(rv.name)}</span>
            <span>
              <strong>{rv.name}</strong>
              <small>{rv.city}</small>
              {lang === 'es' && <small class="review__tr">{t('reviews.translated')}</small>}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .reviews__rating {
    text-align: center;
    font-weight: 700;
    color: var(--green-800);
    margin-bottom: 24px;
  }
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px;
  }
  .reviews--full .reviews__grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
  }
  .review {
    margin: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px 26px 24px;
    box-shadow: var(--shadow-sm);
  }
  .review__quote {
    width: 34px;
    height: 34px;
    color: var(--green-500);
    opacity: 0.55;
    margin-bottom: 12px;
  }
  .review blockquote {
    margin: 0 0 20px;
    flex: 1;
  }
  .review__highlight {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--green-900);
    font-weight: 500;
  }
  .review__text {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin: 0;
  }
  .review figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.3;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .review figcaption strong {
    display: block;
    color: var(--green-900);
  }
  .review figcaption small {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .review__tr {
    font-style: italic;
    font-size: 0.75rem !important;
  }
  .review__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--green-700);
    color: var(--white);
    font-weight: 700;
    flex: none;
  }
</style>
