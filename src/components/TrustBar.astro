---
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const items = [
  { icon: 'shield', title: t('trust.licensed'), sub: t('trust.license') },
  { icon: 'award', title: t('trust.years'), sub: lang === 'en' ? 'Serving the Inland Empire' : 'Sirviendo al Inland Empire' },
  { icon: 'dollar', title: t('trust.free'), sub: t('trust.budget') },
  site.familyOwned
    ? { icon: 'users', title: t('trust.family'), sub: site.spanishSpoken ? t('trust.spanish') : '' }
    : { icon: 'chat', title: lang === 'en' ? 'Fast, Clear Communication' : 'Comunicación Rápida y Clara', sub: '' },
];
---

<section class="trust" aria-label={lang === 'en' ? 'Why you can trust us' : 'Por qué puede confiar en nosotros'}>
  <div class="container trust__grid">
    {
      items.map((it) => (
        <div class="trust__item">
          <span class="trust__icon">
            <Icon name={it.icon} size={26} />
          </span>
          <span>
            <strong>{it.title}</strong>
            {it.sub && <small>{it.sub}</small>}
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-block: 26px;
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 14px;
    line-height: 1.3;
  }
  .trust__item strong {
    display: block;
    color: var(--green-900);
    font-size: 0.98rem;
  }
  .trust__item small {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .trust__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--green-100);
    color: var(--green-700);
    flex: none;
  }
  @media (max-width: 960px) {
    .trust__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .trust__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
