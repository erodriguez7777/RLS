---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import photo from '../assets/photos/string-trimmer.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const items = [
  { icon: 'award', title: t('why.1.title'), text: t('why.1.text') },
  { icon: 'shield', title: t('why.2.title'), text: t('why.2.text') },
  { icon: 'dollar', title: t('why.3.title'), text: t('why.3.text') },
  { icon: 'chat', title: t('why.4.title'), text: t('why.4.text') },
];
---

<section class="section why">
  <div class="container why__grid">
    <div class="why__media reveal">
      <Image quality={68} src={photo} alt={lang === 'en' ? 'Crew member trimming a lawn edge' : 'Trabajador orillando el pasto'} widths={[500, 900]} sizes="(max-width: 900px) 100vw, 520px" />
      <div class="why__badge">
        <strong>{site.years}+</strong>
        <span>{lang === 'en' ? 'Years serving Inland Empire homeowners' : 'Años sirviendo a familias del Inland Empire'}</span>
      </div>
    </div>
    <div>
      <span class="eyebrow">{t('section.why.eyebrow')}</span>
      <h2>{t('section.why.title')}</h2>
      <div class="why__list">
        {
          items.map((it) => (
            <div class="why__item reveal">
              <span class="why__icon">
                <Icon name={it.icon} />
              </span>
              <div>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <a class="why__verify" href={site.cslbUrl} target="_blank" rel="noopener">
        <Icon name="shield" size={18} />
        {lang === 'en' ? `Verify CA License #${site.license} on the CSLB website` : `Verifique la Licencia CA #${site.license} en el sitio del CSLB`}
      </a>
    </div>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .why__media {
    position: relative;
  }
  .why__media :global(img) {
    border-radius: 20px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
    box-shadow: var(--shadow-lg);
  }
  .why__badge {
    position: absolute;
    right: -18px;
    bottom: 28px;
    background: var(--amber);
    color: var(--amber-ink);
    border-radius: 16px;
    padding: 18px 22px;
    max-width: 210px;
    box-shadow: var(--shadow);
    line-height: 1.25;
  }
  .why__badge strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    margin-bottom: 4px;
  }
  .why__badge span {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .why__list {
    display: grid;
    gap: 22px;
    margin: 28px 0;
  }
  .why__item {
    display: flex;
    gap: 18px;
  }
  .why__item h3 {
    margin-bottom: 4px;
  }
  .why__item p {
    color: var(--ink-soft);
    margin: 0;
  }
  .why__icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: var(--green-100);
    color: var(--green-700);
    flex: none;
  }
  .why__verify {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-weight: 600;
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
    .why__media {
      max-width: 520px;
    }
    .why__media :global(img) {
      aspect-ratio: 4 / 3;
    }
    .why__badge {
      right: 12px;
    }
  }
</style>
