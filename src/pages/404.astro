---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, telHref } from '../data/site';
---

<Base lang="en" title="Page Not Found | Rodriguez Landscaping" description="This page could not be found." alternate="/es/" noindex>
  <section class="section nf">
    <div class="container nf__inner">
      <span class="eyebrow">404</span>
      <h1>This page wandered off the path.</h1>
      <p>The page you’re looking for doesn’t exist. Let’s get you back on track. <span lang="es">· Esta página no existe.</span></p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="/">Go to homepage</a>
        <a class="btn btn--ghost btn--lg" href="/es/">Ir al inicio en español</a>
        <a class="btn btn--ghost btn--lg" href={telHref}><Icon name="phone" /> {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf__inner {
    max-width: 720px;
    text-align: center;
  }
  .nf .btn-row {
    justify-content: center;
  }
  .nf p {
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
</style>
