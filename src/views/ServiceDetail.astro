---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EstimateForm from '../components/EstimateForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import AreasList from '../components/AreasList.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { getService, type Service } from '../data/services';
import { reviews } from '../data/reviews';
import { site, telHref } from '../data/site';
import { r, servicePath, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  service: Service;
}
const { lang, service: s } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';
const related = s.related.map(getService);
const matched = reviews.filter((rv) => rv.service === s.id);
const shownReviews = [...matched, ...reviews.filter((rv) => rv.service !== s.id)].slice(0, 2);

const title =
  lang === 'en'
    ? `${s.title.en} in the Inland Empire | Rodriguez Landscaping`
    : `${s.title.es} en el Inland Empire | Rodriguez Landscaping`;
const description = `${s.short[lang]} ${lang === 'en' ? `Licensed & insured (CA #${site.license}). Free estimates: ${site.phone}.` : `Con licencia y seguro (CA #${site.license}). Estimados gratis: ${site.phone}.`}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title[lang],
    serviceType: s.title.en,
    description: s.short[lang],
    provider: { '@id': `${site.url}/#business` },
    areaServed: { '@type': 'AdministrativeArea', name: 'Inland Empire, CA' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL(r('home', lang), site.url).href },
      { '@type': 'ListItem', position: 2, name: t('nav.services'), item: new URL(r('services', lang), site.url).href },
      { '@type': 'ListItem', position: 3, name: s.title[lang] },
    ],
  },
];
---

<Base lang={lang} title={title} description={description} alternate={servicePath(s.slug, other)} schema={schema}>
  <PageHero
    image={s.image}
    eyebrow={t('service.areas')}
    title={s.headline[lang]}
    text={s.short[lang]}
    crumbs={[
      { href: r('home', lang), label: t('breadcrumb.home') },
      { href: r('services', lang), label: t('nav.services') },
      { label: s.title[lang] },
    ]}
  >
    <div class="btn-row">
      <a class="btn btn--primary btn--lg" href="#estimate">{t('cta.estimate')}</a>
      <a class="btn btn--ghost-light btn--lg" href={telHref} data-track="call-service-hero"><Icon name="phone" /> {site.phone}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container sd">
      <div class="sd__main">
        <div class="prose">
          {s.intro[lang].map((p) => <p>{p}</p>)}
        </div>

        <div class="sd__cols">
          <div class="card sd__box">
            <h2 class="sd__h">{t('service.included')}</h2>
            <ul class="checks">{s.included[lang].map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="card sd__box">
            <h2 class="sd__h">{t('service.benefits')}</h2>
            <ul class="checks">{s.benefits[lang].map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>

        <figure class="sd__figure">
          <Image quality={68} src={s.image} alt={s.title[lang]} widths={[600, 1000]} sizes="(max-width: 980px) 100vw, 700px" />
        </figure>

        <h2>{t('service.faq')}</h2>
        <FAQ lang={lang} items={s.faqs} />
      </div>

      <aside class="sd__aside">
        <div class="sd__sticky">
          <EstimateForm lang={lang} defaultService={s.id} compact />
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t('section.reviews.eyebrow')}</span>
        <h2>{t('section.reviews.title')}</h2>
      </div>
      <Testimonials lang={lang} items={shownReviews} full />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t('service.related')}</h2>
      </div>
      <div class="grid grid--3">
        {related.map((rs) => <ServiceCard service={rs} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section section--sand section--tight">
    <div class="container">
      <div class="section-head">
        <h2>{s.title[lang]} — {t('section.areas.title')}</h2>
      </div>
      <AreasList lang={lang} />
    </div>
  </section>

  <CTABand lang={lang} />
</Base>

<style>
  .sd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .sd__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 32px 0;
  }
  .sd__box {
    padding: 26px;
  }
  .sd__box .checks {
    margin: 0;
  }
  .sd__h {
    font-size: 1.35rem;
  }
  .sd__figure {
    margin: 0 0 48px;
  }
  .sd__figure :global(img) {
    border-radius: 18px;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .sd__sticky {
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }
  .sd__main :global(.faq) {
    margin: 0;
  }
  @media (max-width: 1080px) {
    .sd {
      grid-template-columns: 1fr;
    }
    .sd__aside {
      max-width: 560px;
    }
  }
  @media (max-width: 640px) {
    .sd__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
