---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustBar from '../components/TrustBar.astro';
import Process from '../components/Process.astro';
import CTABand from '../components/CTABand.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import { r, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import heroImg from '../assets/photos/garden-design.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';
const title =
  lang === 'en'
    ? 'Landscaping Services in the Inland Empire | Rodriguez Landscaping'
    : 'Servicios de Jardinería en el Inland Empire | Rodriguez Landscaping';
const description =
  lang === 'en'
    ? `Lawn maintenance, sod, sprinkler systems, landscape design, drought-tolerant yards, tree trimming and hardscape. Licensed & insured, ${site.years}+ years. Free estimates.`
    : `Mantenimiento de jardines, pasto, riego, diseño, jardines de bajo consumo, poda de árboles y hardscape. Con licencia y seguro, más de ${site.years} años. Estimados gratis.`;
---

<Base lang={lang} title={title} description={description} alternate={r('services', other)}>
  <PageHero
    image={heroImg}
    eyebrow={t('section.services.eyebrow')}
    title={t('section.services.title')}
    text={t('section.services.text')}
    crumbs={[{ href: r('home', lang), label: t('breadcrumb.home') }, { label: t('nav.services') }]}
  >
    <a class="btn btn--primary btn--lg" href={r('contact', lang)}>{t('cta.estimate')}</a>
  </PageHero>
  <TrustBar lang={lang} />
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} lang={lang} />)}
      </div>
    </div>
  </section>
  <Process lang={lang} />
  <CTABand lang={lang} />
</Base>
